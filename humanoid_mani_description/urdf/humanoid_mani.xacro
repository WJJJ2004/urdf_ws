<joint name="rotate_torso" type="revolute">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="torso_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
  <limit effort="100.0" lower="-3.1415" upper="3.1415" velocity="1.0"/>
</joint>

<joint name="rgb_dummy" type="fixed">
  <origin xyz="0.001987 0.017963 0.04" rpy="0 0 0"/>
  <parent link="Head_1"/>
  <child link="eye_1"/>
</joint>

<joint name="rotate_1" type="revolute">
  <origin xyz="-0.000642 -0.093026 0.10546" rpy="0 0 0"/>
  <parent link="torso_1"/>
  <child link="shoulder_1"/>
  <axis xyz="0.000712 -1.0 -0.0"/>
  <limit effort="100.0" lower="-3.1415" upper="3.1415" velocity="1.0"/>
</joint>

<joint name="rotate_3" type="revolute">
  <origin xyz="-0.021447 -0.032515 -0.025" rpy="1.5708 0 0"/>
  <parent link="shoulder_1"/>
  <child link="upperarm_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <limit effort="100.0" lower="-1.5708" upper="1.5708" velocity="1.0"/>
</joint>

<joint name="rotate_tilt" type="revolute">
