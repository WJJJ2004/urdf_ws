<xacro:include filename="$(find humanoid_mani_description)/urdf/humanoid_mani.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.00014449791335857415 1.0295259413262148e-07 -0.0024804736407786827" rpy="0 0 0"/>
    <mass value="0.03383387831439711"/>
