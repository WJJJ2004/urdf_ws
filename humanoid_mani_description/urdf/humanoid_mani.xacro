</joint>

<joint name="rotate_5" type="revolute">
  <origin xyz="0.020652 -0.143185 0.020499" rpy="0 0 0"/>
  <parent link="upperarm_1"/>
  <child link="forearm_1"/>
  <axis xyz="0.0 -7e-06 1.0"/>
  <limit effort="100.0" lower="-2.462" upper="2.4" velocity="1.0"/>
</joint>

<joint name="ee_dummy" type="fixed">
  <origin xyz="0.004518 -0.164819 -0.020415" rpy="0 0 0"/>
  <parent link="forearm_1"/>
  <child link="ee_link_1"/>
</joint>

